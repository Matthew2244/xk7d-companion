<Project Sdk="Microsoft.NET.Sdk">
  <!-- CI's check of the real Windows app through UI Automation, the interface NVDA, JAWS and
       Narrator read from: every control named, sliders reading display values, the keyboard
       stepping and refusing to guess. Usage: UiaCheck path\to\XK7DCompanion.exe -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>XK7D.UiaCheck</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../XK7DCore/XK7DCore.csproj" />
  </ItemGroup>
</Project>
